<?php
// The parts of nope's standard library Waypoint\Nope uses, for PHPStan only: nope provides them at runtime.

namespace Nope {
    /** @template T */
    final class AsyncLocal
    {
        /** @return T|null */
        public function get(): mixed {}

        /** @param T|null $value */
        public function set(mixed $value): void {}
    }
}

namespace Nope\Http {
    final class Request
    {
        public readonly string $method;
        public readonly string $uri;
        /** @var array<string, string> lower-cased names */
        public readonly array $headers;
        public readonly string $body;

        public function header(string $name): ?string {}

        /** @return array<string, mixed> */
        public function cookies(): array {}

        /** @return array<string, mixed> */
        public function form(): array {}
    }

    final class Response
    {
        /** @param array<string, string|list<string>> $headers */
        public function __construct(string $body = '', int $status = 200, array $headers = []) {}
    }

    /**
     * @param callable(Request): Response $handler
     * @param string|array<string, string>|null $static
     */
    function serve(int $port, callable $handler, string|array|null $static = null): void {}
}
