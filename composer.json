{
  "name": "systonia/waypoint",
  "description": "A lightweight PHP framework for building APIs and progressively enhanced UIs, with attribute-based routing and partial HTML views over AJAX.",
  "keywords": [
    "php",
    "framework",
    "api",
    "routing",
    "attributes",
    "middleware",
    "cors",
    "gzip",
    "partial-views",
    "progressive-enhancement",
    "ajax",
    "stateless"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Lento Leisenfeld",
      "email": "lento@leisenfeld.com"
    }
  ],
  "scripts": {
    "test": "vendor/bin/phpunit --testdox --display-deprecations --display-warnings",
    "e2e": "php vendor/bin/phpunit --testdox Tests/EndToEnd",
    "coverage:text": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text",
    "coverage:html": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html coverage/"
  },
  "autoload": {
    "psr-4": {
      "Waypoint\\": "src/Waypoint/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Waypoint\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.5",
    "psr/container": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "monolog/monolog": "^3.9",
    "phpunit/phpunit": "^13.3"
  },
  "suggest": {
    "monolog/monolog": "Powerful logging with handlers, channels, and JSON output."
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
